# Copy to .env at the repo root for local development. Never commit .env.
# Comments sit on their own lines so no env parser mistakes them for values.

# --- API (apps/api) ---
SUPABASE_URL=
# API only. Never in web or extension.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
# true = mock provider only, labelled in the UI
OFFLINE_MODE=false
# Required for admin endpoints; shared with judges in the README
DEMO_ADMIN_CODE=
RATE_LIMIT_PER_CLIENT_PER_DAY=50
GLOBAL_DAILY_CAP=1000
CLIENT_HASH_SALT=
# Comma-separated origins, e.g. https://<web>.vercel.app (http://localhost:5173 is always allowed)
CORS_ORIGINS=
# Local only; Vercel ignores it
PORT=3001

# Local only, for the Supabase CLI. Not used by the API and never set on Vercel.
SUPABASE_DB_PASSWORD=

# --- Web (apps/web) ---
VITE_API_URL=http://localhost:3001
