{
  "name": "@clearance-gateway/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p ../../packages/core/tsconfig.build.json && tsc -p tsconfig.build.json --noEmit",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsc -p ../../packages/core/tsconfig.build.json && tsx scripts/seed-policy.ts",
    "compiler-check": "tsc -p ../../packages/core/tsconfig.build.json && tsx scripts/compiler-check.ts"
  },
  "dependencies": {
    "@clearance-gateway/core": "*",
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22",
    "typescript": "~5.9.3"
  }
}
