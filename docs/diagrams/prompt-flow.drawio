<mxfile host="Clearance Gateway" agent="hand-tuned"><diagram id="prompt-flow" name="prompt-flow"><mxGraphModel dx="1150" dy="1560" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="1560" background="#FBFAF7" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;What happens to one prompt&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=30;fontColor=#14140F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="900" height="44" as="geometry"/></mxCell><mxCell id="c2" value="from the moment an employee presses Send" style="text;html=1;whiteSpace=wrap;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=15;fontColor=#5C5B52;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="900" height="26" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;no LLM in this path.&lt;/b&gt;&lt;br&gt;every decision is a fixed, testable rule" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFF6C9;fillStyle=solid;strokeColor=#8A8779;strokeWidth=1.5;fontSize=15;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;rotation=2;" vertex="1" parent="1"><mxGeometry x="720" y="30" width="380" height="74" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;employee sends a prompt&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#F1EFE8;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=15;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="280" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;undo tricks&lt;/b&gt;&lt;br&gt;spaced digits, zero-width chars, fullwidth numbers" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=14;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="360" height="74" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;find sensitive data&lt;/b&gt;&lt;br&gt;SA ID numbers · cards · bank accounts · emails · phones · keys · client names" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=14;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="360" height="86" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;look up the rule for each finding&lt;/b&gt;&lt;br&gt;role × data type × provider tier" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=14;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="452" width="360" height="74" as="geometry"/></mxCell><mxCell id="c8" value="blocked for&lt;br&gt;every provider?" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=15;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;rhombus;" vertex="1" parent="1"><mxGeometry x="330" y="560" width="300" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;BLOCKED&lt;/b&gt;&lt;br&gt;“remove the key and try again”" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FBF3EE;fillStyle=solid;strokeColor=#A65D3A;strokeWidth=2.5;fontSize=15;fontColor=#A65D3A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="790" y="580" width="300" height="92" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;redact or pseudonymise&lt;/b&gt;&lt;br&gt;[REDACTED:SA_ID] · [CLIENT_NAME_1]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=14;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="726" width="360" height="80" as="geometry"/></mxCell><mxCell id="c11" value="is a provider &lt;b&gt;up&lt;/b&gt; and&lt;br&gt;&lt;b&gt;cleared&lt;/b&gt; for this data?" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=15;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;rhombus;" vertex="1" parent="1"><mxGeometry x="310" y="842" width="340" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;BLOCKED — fail closed&lt;/b&gt;&lt;br&gt;nothing is sent anywhere" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FBF3EE;fillStyle=solid;strokeColor=#A65D3A;strokeWidth=2.5;fontSize=15;fontColor=#A65D3A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="790" y="872" width="300" height="92" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;send only the redacted text&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#E4EEE7;fillStyle=solid;strokeColor=#12503A;strokeWidth=2.5;fontSize=15;fontColor=#12503A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="1030" width="360" height="70" as="geometry"/></mxCell><mxCell id="c14" value="provider&lt;br&gt;answered?" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=15;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;rhombus;" vertex="1" parent="1"><mxGeometry x="360" y="1136" width="240" height="120" as="geometry"/></mxCell><mxCell id="c15" value="mark it &lt;b&gt;down&lt;/b&gt;,&lt;br&gt;route again" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#F1EFE8;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=14;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="30" y="1160" width="210" height="74" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;check the reply&lt;/b&gt;&lt;br&gt;new sensitive data? leaked instructions?&lt;br&gt;then put the real names back" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=14;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="1292" width="360" height="86" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;answer + a plain-English “why”&lt;/b&gt;&lt;br&gt;audit log: metadata only" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#E4EEE7;fillStyle=solid;strokeColor=#12503A;strokeWidth=2;fontSize=15;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="320" y="1414" width="320" height="80" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;fontColor=#5C5B52;stroke