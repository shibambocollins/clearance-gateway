<mxfile host="Clearance Gateway"><diagram id="data-model" name="data-model"><mxGraphModel dx="980" dy="540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="540" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="What the audit log stores: metadata only" style="text;html=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="0" y="14" width="980" height="34" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;audit_events&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;id · bigint&lt;br&gt;at · timestamptz&lt;br&gt;channel · text (web, extension, api, eval)&lt;br&gt;role · text&lt;br&gt;policy_version · int&lt;br&gt;data_classes · text[] (e.g. SA_ID)&lt;br&gt;final_action · text (allow, redact, tokenise, block)&lt;br&gt;rule_ids · text[] (e.g. R-PII-01)&lt;br&gt;provider · text&lt;br&gt;outcome · text (sent, blocked, error)&lt;br&gt;latency_ms · int&lt;br&gt;prev_hash · text (optional)&lt;br&gt;hash · text (optional)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;strokeColor=#666666;fillColor=#FFFFFF;align=left;spacingLeft=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="460" height="330" as="geometry"/></mxCell><mxCell id="c3" value="&lt;s&gt;prompt_text&lt;/s&gt; &amp;nbsp; &lt;s&gt;reply_text&lt;/s&gt; &amp;nbsp; &lt;s&gt;ip_address&lt;/s&gt;&lt;br&gt;&lt;b&gt;no such columns&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;strokeColor=#666666;fillColor=#FFFFFF;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="460" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;usage_counters&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;day · date&lt;br&gt;client_hash · text (salted hash, never the raw IP)&lt;br&gt;count · int" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;strokeColor=#666666;fillColor=#FFFFFF;align=left;spacingLeft=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="380" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;simulated_outages&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;provider_id · text&lt;br&gt;down · boolean&lt;br&gt;updated_at · timestamptz (expires after 10 min)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;strokeColor=#666666;fillColor=#FFFFFF;align=left;spacingLeft=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="560" y="210" width="380" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;policy_versions&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;version · int&lt;br&gt;raw_text · text (the policy, not a prompt)&lt;br&gt;compiled · jsonb&lt;br&gt;status · draft, active or archived&lt;br&gt;compiled_by · activated_at" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;strokeColor=#666666;fillColor=#FFFFFF;align=left;spacingLeft=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="560" y="340" width="380" height="136" as="geometry"/></mxCell><mxCell id="c7" value="From supabase/schema.sql. Row-level security is on for every table, with no policies: only the API's service role can read or write." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="496" width="900" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>