<mxfile host="Clearance Gateway"><diagram id="policy-lifecycle" name="policy-lifecycle"><mxGraphModel dx="640" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="640" pageHeight="760" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Clearance Gateway: how a policy goes live" style="text;html=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="0" y="14" width="640" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Admin writes the AI policy&lt;br&gt;in plain English" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;strokeColor=#666666;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="240" height="50" as="geometry"/></mxCell><mxCell id="c3" value="LLM compiler drafts rules&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;a draft only, never enforced&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;strokeColor=#666666;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="240" height="50" as="geometry"/></mxCell><mxCell id="c4" value="Passes the strict&lt;br&gt;schema check?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;strokeColor=#666666;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="220" y="230" width="200" height="100" as="geometry"/></mxCell><mxCell id="c5" value="Retry once with the errors,&lt;br&gt;then the next provider" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;strokeColor=#666666;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="450" y="255" width="170" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Admin reviews what changes&lt;br&gt;&lt;font style=&quot