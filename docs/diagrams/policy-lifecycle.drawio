<mxfile host="Clearance Gateway" agent="hand-tuned"><diagram id="policy-lifecycle" name="policy-lifecycle"><mxGraphModel dx="1700" dy="500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="500" background="#FBFAF7" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;How a policy goes live&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=30;fontColor=#14140F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1100" height="44" as="geometry"/></mxCell><mxCell id="c2" value="write it once in plain English — a person stays in charge of every change" style="text;html=1;whiteSpace=wrap;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=15;fontColor=#5C5B52;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1100" height="26" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;admin writes the AI policy&lt;/b&gt;&lt;br&gt;in plain English" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=15;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;shape=document;size=0.15;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="210" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;LLM compiler&lt;/b&gt;&lt;br&gt;drafts the rules" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=15;fontColor=#14140F;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="290" y="160" width="220" height="120" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;html=1;verticalLabelPosition=bottom;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="312" y="230" width="34" height="34" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=image;html=1;verticalLabelPosition=bottom;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="356" y="232" width="30" height="30" as="geometry"/></mxCell><mxCell id="c7" value="drafts only —&lt;br&gt;never enforces" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFF6C9;fillStyle=solid;strokeColor=#8A8779;strokeWidth=1.5;fontSize=15;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;rotation=-3;" vertex="1" parent="1"><mxGeometry x="290" y="310" width="220" height="58" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;strict schema check&lt;/b&gt;&lt;br&gt;the LLM can’t add providers or permissions" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=14;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="210" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;review what changes&lt;/b&gt;&lt;br&gt;looser decisions in red&lt;br&gt;+ try it in the simulator" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#EEF1E7;fillStyle=solid;strokeColor=#7D8B6A;strokeWidth=2;fontSize=14;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="820" y="160" width="230" height="120" as="geometry"/></mxCell><mxCell id="c10" value="looser than&lt;br&gt;the baseline&lt;br&gt;&lt;b&gt;floor&lt;/b&gt;?" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=15;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;rhombus;" vertex="1" parent="1"><mxGeometry x="1095" y="145" width="200" height="150" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;refused&lt;/b&gt;&lt;br&gt;(nothing changes)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FBF3EE;fillStyle=solid;strokeColor=#A65D3A;strokeWidth=2.5;fontSize=15;fontColor=#A65D3A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1100" y="360" width="190" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;admin activates&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;strokeColor=#14140F;strokeWidth=2;fontSize=15;fontColor=#14140F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1340" y="160" width="150" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;live everywhere&lt;/b&gt;&lt;br&gt;in ~5 seconds" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#E4EEE7;fillStyle=solid;strokeColor=#12503A;strokeWidth=2;fontSize=15;fontColor=#12503A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1530" y="170" width="150" height="100" as="geometry"/></mxCell><mxCell id="c14" value="" style="html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;fontColor=#5C5B52;strokeColor=#14140F;strokeWidth=2;endArrow=classic;endFill=1;rounded=1;labelBackgroundColor=#FBFAF7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;fontColor=#5C5B52;strokeColor=#14140F;strokeWidth=2;endArrow=classic;endFill=1;rounded=1;labelBackgroundColor=#FBFAF7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;fontColor=#5C5B52;strokeColor=#14140F;strokeWidth=2;endArrow=classic;endFill=1;rounded=1;labelBackgroundColor=#FBFAF7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;fontColor=#5C5B52;strokeColor=#14140F;strokeWidth=2;endArrow=classic;endFill=1;rounded=1;labelBackgroundColor=#FBFAF7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="yes" style="html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=15;fontColor=#A65D3A;strokeColor=#A65D3A;strokeWidth=2;endArrow=classic;endFill=1;rounded=1;labelBackgroundColor=#FBFAF7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="no" style="html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=15;fontColor=#12503A;strokeColor=#14140F;strokeWidth=2;endArrow=classic;endFill=1;rounded=1;labelBackgroundColor=#FBFAF7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;fontColor=#5C5B52;strokeColor=#12503A;strokeWidth=2;endArrow=classic;endFill=1;rounded=1;labelBackgroundColor=#FBFAF7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="every save is a new version · nothing compiled is enforced until a person activates it · &lt;b&gt;Reset&lt;/b&gt; restores the original policy" style="text;html=1;whiteSpace=wrap;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;fontColor=#5C5B52;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="335" width="520" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>