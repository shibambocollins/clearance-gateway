{
  "name": "@clearance-gateway/core",
  "version": "0.3.0",
  "private": true,
  "description": "Clearance Gateway Engine: canonicalise, detect, decide, transform, route. Pure TypeScript, no I/O.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./samples": {
      "types": "./dist/samples.d.ts",
      "default": "./dist/samples.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
